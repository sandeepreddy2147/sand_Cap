# Copy to .env and adjust. Never commit .env.

# Read-only working copy of the six original CSVs (byte-identical to capstone_ACC-main/Chicago Datasets)
RAW_DATA_DIR=data/raw

# Derived outputs (safe to delete and regenerate)
PROCESSED_DATA_DIR=data/processed
DATA_REPORTS_DIR=data/reports
REPORTS_DIR=reports/figures

# SQLite database file (relative to project root)
DATABASE_PATH=database/chicago_crime.db
# Optional: a full SQLAlchemy URL overrides DATABASE_PATH, e.g. for MySQL 8 (needs: pip install pymysql)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/chicago_crime

LOG_LEVEL=INFO

# Flask backend (app/app.py). FLASK_SECRET_KEY is required when FLASK_ENV=production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_ENV=development
FLASK_SECRET_KEY=
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
API_DEFAULT_PAGE_SIZE=25
API_MAX_PAGE_SIZE=100
